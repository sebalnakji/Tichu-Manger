# App Environment (local/prod)
APP_ENV=local

# Database
DATABASE_URL=sqlite:///tichu.db

# Server
HOST=0.0.0.0
PORT=8000

# Auth
ADMIN_CODE=change-me-in-production

# Supabase
# DATABASE_URL=postgresql://[supabase-postgresql-url]
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_BUCKET=tichu-profiles

# Keep false while Render is connected to the old Supabase project.
ENABLE_CLEANUP_SCHEDULER=false
