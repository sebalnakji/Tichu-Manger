# App Environment (local/prod)
APP_ENV=local

# Database
DATABASE_URL=sqlite:///tichu.db
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2
DB_POOL_TIMEOUT=10
DB_POOL_RECYCLE=300

# Server
HOST=0.0.0.0
PORT=8000

# Auth
ADMIN_CODE=change-me-in-production

# Supabase
# DATABASE_URL=postgresql://[supabase-postgresql-url]
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_BUCKET=tichu-profiles

# Enable only on the single deployment responsible for scheduled cleanup.
ENABLE_CLEANUP_SCHEDULER=false
